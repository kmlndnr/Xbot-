[Unit]
Description=Xbot Auto-Reply Service
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/xbot
ExecStart=/opt/xbot/venv/bin/python /opt/xbot/main.py --auto
Restart=on-failure
RestartSec=30
EnvironmentFile=/opt/xbot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
