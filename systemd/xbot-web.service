[Unit]
Description=Xbot Web Dashboard
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/xbot
ExecStart=/opt/xbot/venv/bin/python /opt/xbot/web_dashboard/app.py
Restart=on-failure
RestartSec=10
EnvironmentFile=/opt/xbot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
