# ── Twitter / X API Credentials ───────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here
TWITTER_USER_ID=

# ── Anthropic API ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Polling ────────────────────────────────────────────────────────────────────
# Mindestens 900s (15 min) für Twitter Free API
POLL_INTERVAL_SECONDS=900

# ── Filter ────────────────────────────────────────────────────────────────────
# Nur auf Mentions mit diesen Wörtern reagieren (leer = alle)
KEYWORD_FILTER=
# Diese Accounts ignorieren (kommagetrennt, ohne @)
BLACKLIST_ACCOUNTS=
# Quiet Hours: zwischen diesen Uhrzeiten nicht posten
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# ── Sentiment-Filter ──────────────────────────────────────────────────────────
# Mentions mit diesen Sentiments überspringen (kommagetrennt)
# Werte: positive, neutral, negative, aggressive
# Empfehlung: aggressive überspringen, negative ggf. manuell reviewen
SENTIMENT_BLOCK=aggressive

# ── Reactions ─────────────────────────────────────────────────────────────────
# Mentions automatisch liken bevor geantwortet wird
AUTO_LIKE_MENTIONS=false
# Mentions automatisch retweeten
AUTO_RETWEET_MENTIONS=false

# ── DMs ───────────────────────────────────────────────────────────────────────
# DMs beantworten (benötigt dm.read + dm.write OAuth-Scope)
DMS_ENABLED=false

# ── Follower ──────────────────────────────────────────────────────────────────
# Neue Follower mit einer DM begrüßen (benötigt dm.write Scope)
WELCOME_NEW_FOLLOWERS=false
# {username} wird durch den Benutzernamen ersetzt
WELCOME_DM_TEXT=Hey {username}! Danke fürs Folgen 👋 Freue mich auf den Austausch!

# ── Tone-of-Voice ─────────────────────────────────────────────────────────────
# Anzahl eigener Tweets die dem KI-Prompt als Stil-Beispiele mitgegeben werden
# 0 = deaktiviert
TONE_TWEET_COUNT=10

# ── Telegram Review Bot ────────────────────────────────────────────────────────
# true = Entwürfe nicht auto-posten, sondern per Telegram zur Freigabe schicken
TELEGRAM_MODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web Dashboard ──────────────────────────────────────────────────────────────
WEB_PORT=5000
WEB_SECRET_KEY=change-me-to-a-random-string
