# ── Twitter / X API Credentials ───────────────────────────────────────────────
# Erstelle deine Keys unter: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Optional: Deine eigene Twitter User ID (wird automatisch ermittelt, falls leer)
TWITTER_USER_ID=

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Erstelle deinen Key unter: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Auto-Modus ─────────────────────────────────────────────────────────────────
# Intervall in Sekunden zwischen Mention-Checks (min. 900 für Free API)
POLL_INTERVAL_SECONDS=900

# Nur auf Mentions reagieren, die mind. eines dieser Wörter enthalten (kommagetrennt)
# Leer lassen = alle Mentions bearbeiten
KEYWORD_FILTER=

# Diese Accounts komplett ignorieren (kommagetrennt, ohne @)
BLACKLIST_ACCOUNTS=

# Zwischen diesen Uhrzeiten NICHT posten (Stunden 0-23)
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# Anzahl eigener Tweets für Tone-of-Voice-Profil (0 = deaktiviert)
TONE_TWEET_COUNT=10

# DM-Verarbeitung aktivieren (benötigt dm.read + dm.write OAuth-Scope)
DMS_ENABLED=false

# ── Telegram Review Bot ────────────────────────────────────────────────────────
# true = Entwürfe werden NICHT automatisch gepostet, sondern per Telegram zur
#         Freigabe geschickt (Human-in-the-loop via Telegram statt Terminal)
TELEGRAM_MODE=false
# Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Deine persönliche Chat-ID (ermitteln via @userinfobot)
TELEGRAM_CHAT_ID=

# ── Web Dashboard ──────────────────────────────────────────────────────────────
WEB_PORT=5000
WEB_SECRET_KEY=change-me-to-a-random-string
